{
  "name": "salesforce-org-audit",
  "private": true,
  "version": "1.0.0",
  "description": "Comprehensive Salesforce Org Audit Framework - Technical debt analysis, code quality, and best practices review",
  "author": "nCino Customer Success EMEA <felipe.lopez@ncino.com>",
  "scripts": {
    "lint": "eslint **/{aura,lwc}/**/*.js",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "audit:pmd": "node scripts/analyze-pmd-results.js",
    "audit:flows": "node scripts/analyze-flows.js",
    "audit:objects": "node scripts/analyze-objects.js",
    "audit:apex": "node scripts/analyze-apex-classes.js",
    "audit:layouts": "node scripts/analyze-layouts.js",
    "audit:packages": "node scripts/analyze-packages.js",
    "audit:frameworks": "node scripts/analyze-frameworks.js",
    "audit:security": "node scripts/analyze-security.js",
    "audit:descriptions": "node scripts/analyze-metadata-descriptions.js",
    "audit:advanced": "node scripts/analyze-advanced-rules.js",
    "audit:consolidate": "node scripts/consolidate-findings.js",
    "audit:summary": "node scripts/generate-executive-summary.js",
    "audit:all": "npm run audit:pmd && npm run audit:flows && npm run audit:objects && npm run audit:apex && npm run audit:layouts && npm run audit:packages && npm run audit:frameworks && npm run audit:security && npm run audit:descriptions && npm run audit:advanced && npm run audit:consolidate && npm run audit:summary",
    "dashboard": "cd docs && python3 -m http.server 8080",
    "dashboard:win": "cd docs && python -m http.server 8080"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
        "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
